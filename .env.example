# EchoAid Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------
# Application
# -----------------------------------------------------------------

APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development

# -----------------------------------------------------------------
# Database
# -----------------------------------------------------------------

DATABASE_URL=sqlite:///./echoaid.db

# -----------------------------------------------------------------
# Guardian Access
# -----------------------------------------------------------------

# PIN to access Guardian Mode (change this!)
GUARDIAN_PIN=1234

# Secret key for signing session tokens.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-generate-a-real-random-string

# Session expiry in minutes
SESSION_EXPIRE_MINUTES=480

# -----------------------------------------------------------------
# AI Provider — Groq (Phase 4)
# -----------------------------------------------------------------

# Groq API base URL (OpenAI-compatible)
AI_PROVIDER_URL=https://api.groq.com/openai/v1

# Groq model — fast inference models available:
# llama-3.1-8b-instant  (fast, free tier)
# llama-3.3-70b-versatile (more capable)
# mixtral-8x7b-32768
AI_MODEL=llama-3.1-8b-instant

# Your Groq API key — get one free at https://console.groq.com
# KEEP THIS SECRET — never commit the real value
AI_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# Max tokens for AI sentence suggestions
AI_MAX_TOKENS=300

# Request timeout in seconds
AI_TIMEOUT_SECONDS=15
