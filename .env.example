# EchoAid Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# -----------------------------------------------------------------
# Application
# -----------------------------------------------------------------

# Host and port for the Uvicorn development server
APP_HOST=127.0.0.1
APP_PORT=8000

# Set to "development" or "production"
APP_ENV=development

# -----------------------------------------------------------------
# Database
# -----------------------------------------------------------------

# Path to the SQLite database file (relative to the project root)
DATABASE_URL=sqlite:///./echoaid.db

# -----------------------------------------------------------------
# Guardian Access (Phase 2)
# -----------------------------------------------------------------

# PIN used to access Guardian Mode.
# Choose a strong PIN and keep it private.
# GUARDIAN_PIN=1234

# Secret key used to sign session tokens (Phase 2).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=replace_with_a_secure_random_string

# -----------------------------------------------------------------
# AI Provider (Phase 4 — optional)
# -----------------------------------------------------------------

# OpenAI-compatible API base URL
# AI_PROVIDER_URL=https://api.openai.com/v1

# Model name to use for sentence generation
# AI_MODEL=gpt-4o-mini

# API key for the AI provider — KEEP THIS SECRET
# AI_API_KEY=sk-...

# Maximum tokens for AI responses
# AI_MAX_TOKENS=256

# Request timeout in seconds
# AI_TIMEOUT_SECONDS=15
